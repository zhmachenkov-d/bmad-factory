{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mutmut",
          "informationUri": "https://github.com/boxed/mutmut"
        }
      },
      "results": [
        {
          "ruleId": "mutmut/survived",
          "level": "warning",
          "message": {
            "text": "Mutant fixture.survived: survived"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/fixture.py"
                }
              }
            }
          ],
          "properties": {
            "mutant": "fixture.survived",
            "status": "survived",
            "exitCode": 0
          }
        }
      ]
    }
  ]
}
