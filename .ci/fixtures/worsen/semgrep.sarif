{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "informationUri": "https://semgrep.dev"
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.fixture",
          "level": "warning",
          "message": {
            "text": "Fixture Semgrep finding for HITL dry-run"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/fixture.py"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
